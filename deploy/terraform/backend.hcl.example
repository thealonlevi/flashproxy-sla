# Copy to backend.hcl (gitignored) and fill in with YOUR state bucket, then:
#   terraform init -backend-config=backend.hcl
#
# The bucket must already exist — see the bootstrap commands in backend.tf.
# Anyone with AWS credentials for the account owning this bucket gets the same
# state; nothing else needs to be copied between machines.

bucket = "your-tfstate-bucket-name"
key    = "flashproxy-status/terraform.tfstate"
region = "us-east-1"
